{
  "name": "fit-connect",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index",
      "/index.html",
      "/v2",
      "/v2.html",
      "/member-manifest.webmanifest"
    ]
  },
  "r2_buckets": [
    { "binding": "FIT_MEDIA" }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "FIT_MEDIA",
        "bucket_name": "fit-connect-media-preview"
      }
    ]
  }
}
